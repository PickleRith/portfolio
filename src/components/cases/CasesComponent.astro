---
import Card from "../global/Card.astro";
import { caseCompetitions } from "@/data/profile";

// The first card is a full-width lead. If that leaves an odd number of cards
// behind it, let the last one span both columns so no orphan sits in a half row.
const total = caseCompetitions.length;
const trailingIsOrphan = total > 1 && (total - 1) % 2 === 1;
---

<div class="flex h-fit w-full flex-col items-center justify-center">
	<div
		class="grid w-[90%] grid-cols-1 gap-5 md:w-[640px] lg:w-[85%] lg:max-w-6xl lg:grid-cols-2"
	>
		{
			caseCompetitions.map((study, i) => (
				<Card
					shadowColor="rgba(37, 99, 235, 0.14)"
					className={`view-fadeUp h-full bg-gradient-to-br from-[#0f151d] to-[#161f2b] transition-colors duration-300 hover:border-[#3b4c63] ${
						i === 0 || (trailingIsOrphan && i === total - 1)
							? "lg:col-span-2"
							: ""
					}`}
				>
					<div class="flex h-full flex-col px-6 py-6">
						<div class="mb-4 flex flex-row items-start justify-between gap-4">
							<div>
								{study.award && (
									<span class="border-accent/40 bg-accent/10 text-accent mb-2 inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[0.65rem] font-semibold">
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											class="h-3 w-3"
											aria-hidden="true"
										>
											<circle cx="12" cy="8" r="6" />
											<path
												d="M8.2 13.5 7 22l5-3 5 3-1.2-8.5"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
										{study.award}
									</span>
								)}
								<h3 class="text-lg leading-tight font-bold">
									{study.competition}
								</h3>
								<p class="text-accent mt-0.5 text-sm">
									{study.client}
								</p>
							</div>
							<span class="border-hairline text-muted-foreground shrink-0 rounded-full border px-2.5 py-1 font-mono text-[0.65rem] whitespace-nowrap">
								{study.date}
							</span>
						</div>

						<div class="mb-4">
							<h4 class="text-muted-foreground mb-1 font-mono text-[0.65rem] tracking-widest uppercase">
								Challenge
							</h4>
							<p class="text-muted-foreground text-sm leading-relaxed">
								{study.challenge}
							</p>
						</div>

						<div class="mb-5">
							<h4 class="text-muted-foreground mb-1 font-mono text-[0.65rem] tracking-widest uppercase">
								Recommendation
							</h4>
							<p class="text-sm leading-relaxed">
								{study.recommendation}
							</p>
						</div>

						{/* headline metric pinned to the bottom so cards align */}
						<div class="border-hairline mt-auto flex flex-row items-baseline gap-3 border-t pt-4">
							<span class="text-accent font-mono text-2xl font-bold">
								{study.metric}
							</span>
							<span class="text-muted-foreground text-xs leading-snug">
								{study.metricLabel}
							</span>
						</div>

						<div class="mt-4 flex flex-row flex-wrap gap-2">
							{study.tags.map((tag) => (
								<span class="border-hairline bg-surface text-muted-foreground rounded-md border px-2 py-0.5 font-mono text-xs">
									{tag}
								</span>
							))}
						</div>
					</div>
				</Card>
			))
		}
	</div>
</div>
