---
import { profile } from "@/data/profile";

const year = new Date().getFullYear();
---

<footer
	class="text-muted-foreground mt-20 flex flex-col items-center justify-center gap-2 px-5 pb-10 text-center text-sm"
>
	<div>© {year} {profile.name}</div>
	<div class="text-xs">
		Built with <a
			href="https://astro.build"
			target="_blank"
			rel="noopener noreferrer"
			class="hover:text-accent underline">Astro</a
		> &amp; <a
			href="https://tailwindcss.com"
			target="_blank"
			rel="noopener noreferrer"
			class="hover:text-accent underline">Tailwind</a
		>.
	</div>
</footer>
